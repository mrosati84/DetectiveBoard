# Required: database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=postgres

# Required: JWT signing (set a strong secret in production)
SECRET_KEY=your-secret-key-here

# Optional: rate limiting on /api/auth/login and /api/auth/register
# Limit string (default: 5 per minute per IP)
# RATE_LIMIT_AUTH=5 per minute
# Storage: memory:// (default, single process) or redis://localhost:6379 for multi-worker
# RATE_LIMIT_STORAGE_URI=memory://
